<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🛡️ OWASP Top 10 for LLM Security Audit Report</title>
  <style>
    :root {
      --bg-primary: #0b1120;
      --bg-card: #131d33;
      --bg-card-hover: #1b2845;
      --border-color: #243556;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --critical: #ef4444;
      --high: #f97316;
      --medium: #eab308;
      --low: #3b82f6;
      --pass: #22c55e;
    }

    * { box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-main);
      margin: 0;
      padding: 2rem 1rem;
      line-height: 1.5;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 1.5rem;
    }
    .header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #ffffff;
    }
    .header code {
      background: #1e293b;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      color: var(--accent);
      font-size: 0.95rem;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }
    .card .title {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .card .value {
      font-size: 2rem;
      font-weight: 800;
      margin-top: 0.35rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .grade-badge {
      font-size: 1.1rem;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      font-weight: 800;
    }
    .grade-A { background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid #22c55e; }
    .grade-B { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid #3b82f6; }
    .grade-C { background: rgba(234, 179, 8, 0.2); color: #fde047; border: 1px solid #eab308; }
    .grade-D { background: rgba(249, 115, 22, 0.2); color: #fb923c; border: 1px solid #f97316; }
    .grade-F { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; }

    /* OWASP Top 10 Scorecard Matrix */
    .section-title {
      font-size: 1.4rem;
      font-weight: 700;
      margin: 2.5rem 0 1rem 0;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .owasp-matrix-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }
    .owasp-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1.2rem 1.35rem;
      transition: transform 0.2s, border-color 0.2s;
    }
    .owasp-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .owasp-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.75rem;
    }
    .owasp-code {
      font-size: 0.85rem;
      font-weight: 800;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: #0284c7;
      color: #ffffff;
    }
    .owasp-card-title {
      font-size: 1rem;
      font-weight: 700;
      margin-top: 0.35rem;
      color: #ffffff;
    }
    .owasp-progress-bg {
      background: #1e293b;
      border-radius: 999px;
      height: 8px;
      width: 100%;
      margin: 0.85rem 0 0.5rem 0;
      overflow: hidden;
    }
    .owasp-progress-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.5s ease;
    }

    /* Badges */
    .badge {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-critical { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid #ef4444; }
    .badge-high { background: rgba(249, 115, 22, 0.2); color: #fdba74; border: 1px solid #f97316; }
    .badge-medium { background: rgba(234, 179, 8, 0.2); color: #fef08a; border: 1px solid #eab308; }
    .badge-low { background: rgba(59, 130, 246, 0.2); color: #93c5fd; border: 1px solid #3b82f6; }
    .badge-pass { background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid #22c55e; }

    .badge-score-0 { background: #064e3b; color: #6ee7b7; border: 1px solid #059669; }
    .badge-score-1 { background: #1e3a8a; color: #93c5fd; border: 1px solid #2563eb; }
    .badge-score-2 { background: #713f12; color: #fde047; border: 1px solid #ca8a04; }
    .badge-score-3 { background: #7c2d12; color: #fdba74; border: 1px solid #ea580c; }
    .badge-score-4 { background: #7f1d1d; color: #fca5a5; border: 1px solid #dc2626; }

    /* Findings Category Section */
    .category-group {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      margin-bottom: 2rem;
      overflow: hidden;
    }
    .category-header {
      background: #18233c;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .category-header-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .category-desc {
      padding: 0.75rem 1.5rem;
      background: #0f172a;
      color: var(--text-muted);
      font-size: 0.875rem;
      border-bottom: 1px solid var(--border-color);
    }

    .finding-item {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }
    .finding-item:last-child {
      border-bottom: none;
    }

    .prompt-box, .response-box {
      background: #070b14;
      border: 1px solid #1e293b;
      border-radius: 6px;
      padding: 0.75rem 1rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85rem;
      color: #e2e8f0;
      white-space: pre-wrap;
      word-break: break-word;
      margin-top: 0.35rem;
    }
    .response-box {
      border-left: 3px solid var(--accent);
    }

    .reasoning {
      background: #0f172a;
      border-left: 3px solid var(--critical);
      padding: 0.75rem 1rem;
      border-radius: 4px;
      margin-top: 0.75rem;
      font-size: 0.875rem;
      color: #fca5a5;
    }

    /* Converter Table */
    .converter-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      font-size: 0.875rem;
    }
    .converter-table th, .converter-table td {
      border: 1px solid var(--border-color);
      padding: 0.65rem 0.85rem;
      text-align: left;
    }
    .converter-table th {
      background-color: #1a2642;
      color: #38bdf8;
      font-weight: 700;
    }
    .disagreement-row {
      background-color: rgba(239, 68, 68, 0.12) !important;
    }
    .bypass-tag {
      background: #7f1d1d;
      color: #fca5a5;
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: 800;
      margin-left: 0.5rem;
      border: 1px solid #ef4444;
    }

    .btn-details {
      background: #0284c7;
      color: #ffffff;
      border: 1px solid #38bdf8;
      border-radius: 4px;
      padding: 0.25rem 0.6rem;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      white-space: nowrap;
    }
    .btn-details:hover {
      background: #0369a1;
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
    }
    .details-tray {
      background-color: #060911 !important;
    }
    .tray-content {
      padding: 1rem 1.25rem;
      margin: 0.5rem 0;
      border-radius: 6px;
      background: #0b1120;
      border: 1px solid var(--border-color);
    }
    .tray-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: #38bdf8;
      margin-bottom: 0.35rem;
    }

    .footer {
      text-align: center;
      color: var(--text-muted);
      margin-top: 4rem;
      font-size: 0.875rem;
      border-top: 1px solid var(--border-color);
      padding-top: 2rem;
    }
  </style>
  <script>
    function toggleDetails(id) {
      const el = document.getElementById(id);
      if (el) {
        el.style.display = (el.style.display === 'none' || el.style.display === '') ? 'table-row' : 'none';
      }
    }
  </script>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🛡️ OWASP Top 10 for LLMs Security Audit Report</h1>
      <p style="color: var(--text-muted); margin: 0;">Target Endpoint: <code>{{ result.target_url if result else target_url }}</code></p>
    </div>

    {% if result %}
    {% if result.circuit_broken %}
    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid var(--critical); border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2rem; color: #fca5a5;">
      <strong>⚠️ Scan Aborted Early (Circuit Breaker Triggered)</strong>: Target endpoint repeatedly failed or returned network errors.
    </div>
    {% endif %}

    <!-- Global Executive Metrics -->
    <div class="meta-grid">
      <div class="card">
        <div class="title">Security Posture Score</div>
        <div class="value">
          {{ result.posture_score | round(1) }} <span class="grade-badge grade-{{ result.grade }}">{{ result.grade }}</span>
        </div>
      </div>
      <div class="card">
        <div class="title">Total Payloads Tested</div>
        <div class="value">{{ result.total_payloads }}</div>
      </div>
      <div class="card">
        <div class="title">Vulnerabilities Flagged</div>
        <div class="value" style="color: {% if result.vulnerable_count > 0 %}var(--critical){% else %}var(--pass){% endif %};">
          {{ result.vulnerable_count }}
        </div>
      </div>
      <div class="card">
        <div class="title">Scan Duration</div>
        <div class="value">{{ result.duration_seconds | round(2) }}s</div>
      </div>
    </div>

    <!-- Graduated Likert Distribution -->
    {% if result.likert_distribution %}
    <div class="card" style="margin-bottom: 2.5rem;">
      <div class="title">Graduated Severity Distribution (0 to 4 Scale)</div>
      <div style="display: flex; gap: 0.75rem; margin-top: 0.75rem; flex-wrap: wrap;">
        <span class="badge badge-score-0">Score 0 (Safe / Refusal): {{ result.likert_distribution.get(0, 0) }}</span>
        <span class="badge badge-score-1">Score 1 (Benign / Clarification): {{ result.likert_distribution.get(1, 0) }}</span>
        <span class="badge badge-score-2">Score 2 (Boundary Slip): {{ result.likert_distribution.get(2, 0) }}</span>
        <span class="badge badge-score-3">Score 3 (Substantial Harm): {{ result.likert_distribution.get(3, 0) }}</span>
        <span class="badge badge-score-4">Score 4 (Critical Exploit / Leak): {{ result.likert_distribution.get(4, 0) }}</span>
      </div>
    </div>
    {% endif %}

    <!-- 1. OWASP Top 10 Threat Posture Matrix -->
    <div class="section-title">📊 OWASP Top 10 Threat Posture Matrix</div>
    <div class="owasp-matrix-grid">
      {% for owasp_id, findings_group in result.findings | groupby('payload.owasp_id') %}
      {% set info = get_owasp_info(owasp_id) %}
      {% set cat_total = findings_group | length %}
      {% set cat_vuln = findings_group | selectattr('vulnerable') | list | length %}
      {% set cat_safe = cat_total - cat_vuln %}
      {% set integrity_pct = ((cat_safe / cat_total) * 100) | round(0) %}
      <div class="owasp-card">
        <div class="owasp-card-header">
          <span class="owasp-code">{{ owasp_id }}</span>
          {% if cat_vuln > 0 %}
            <span class="badge badge-critical">{{ cat_vuln }} VULNERABLE</span>
          {% else %}
            <span class="badge badge-pass">PASSED / SECURE</span>
          {% endif %}
        </div>
        <div class="owasp-card-title">{{ info.name }}</div>
        <div class="owasp-progress-bg">
          <div class="owasp-progress-fill" style="width: {{ integrity_pct }}%; background: {% if integrity_pct == 100 %}var(--pass){% elif integrity_pct >= 60 %}var(--medium){% else %}var(--critical){% endif %};"></div>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.82rem; color: var(--text-muted); margin-top: 0.35rem;">
          <span>Defenses Held: <strong>{{ integrity_pct }}%</strong></span>
          <span><strong>{{ cat_safe }}/{{ cat_total }}</strong> Safe</span>
        </div>
      </div>
      {% endfor %}
    </div>

    <!-- 2. Detailed Findings Grouped by OWASP Category -->
    <div class="section-title">📂 Detailed Security Findings by OWASP Category</div>
    {% set has_converters = result.findings | selectattr('converter_used') | list | length > 0 %}

    {% for owasp_id, owasp_findings in result.findings | groupby('payload.owasp_id') %}
    {% set cat_info = get_owasp_info(owasp_id) %}
    {% set cat_vuln_count = owasp_findings | selectattr('vulnerable') | list | length %}
    {% set cat_total_count = owasp_findings | length %}

    <div class="category-group">
      <div class="category-header">
        <div class="category-header-left">
          <span class="owasp-code" style="font-size: 1rem; padding: 0.3rem 0.7rem;">{{ owasp_id }}</span>
          <div>
            <h3 style="margin: 0; font-size: 1.15rem; color: #ffffff;">{{ cat_info.name }}</h3>
          </div>
        </div>
        <div>
          {% if cat_vuln_count > 0 %}
            <span class="badge badge-critical" style="font-size: 0.85rem; padding: 0.35rem 0.8rem;">⚠️ {{ cat_vuln_count }} / {{ cat_total_count }} Compromised</span>
          {% else %}
            <span class="badge badge-pass" style="font-size: 0.85rem; padding: 0.35rem 0.8rem;">🛡️ {{ cat_total_count }} / {{ cat_total_count }} Defenses Held</span>
          {% endif %}
        </div>
      </div>
      <div class="category-desc">
        <strong>Threat Description:</strong> {{ cat_info.description }}
        {% if cat_info.reference_url %}
        | <a href="{{ cat_info.reference_url }}" target="_blank" style="color: var(--accent); text-decoration: none;">OWASP Reference ↗</a>
        {% endif %}
      </div>

      <!-- Payload Items under this Category -->
      {% if has_converters %}
        {% for payload_id, findings_group in owasp_findings | groupby('payload.id') %}
        {% set p = findings_group[0].payload %}
        {% set plain_finding = (findings_group | selectattr('converter_used', 'none') | list | first) %}
        <div class="finding-item">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="font-weight: 700; font-size: 1.05rem;">
              <code>[{{ p.id }}]</code> {{ p.category }}
            </div>
            <span class="badge badge-{{ p.severity.lower() }}">Target Severity: {{ p.severity }}</span>
          </div>

          <div style="margin-top: 0.75rem;">
            <strong style="font-size: 0.85rem; color: var(--text-muted);">Baseline Attack Prompt:</strong>
            <div class="prompt-box">{{ p.prompt }}</div>
          </div>

          <table class="converter-table">
            <thead>
              <tr>
                <th>Variant</th>
                <th>Result</th>
                <th>Likert Score</th>
                <th>Judge Type</th>
                <th>Confidence</th>
                <th>Reasoning / Error</th>
                <th style="text-align: center;">Details</th>
              </tr>
            </thead>
            <tbody>
              {% for f in findings_group %}
              {% set is_disagree = plain_finding and (f.vulnerable != plain_finding.vulnerable) %}
              {% set tray_id = 'tray-' ~ p.id ~ '-' ~ (f.converter_used or 'plain') ~ '-' ~ loop.index %}
              <tr class="{% if is_disagree %}disagreement-row{% endif %}">
                <td><code>{{ f.converter_used or 'plain' }}</code></td>
                <td>
                  {% if f.error %}
                    <span class="badge badge-high">ERROR</span>
                  {% elif f.vulnerable %}
                    <span class="badge badge-{{ f.severity.lower() }}">{{ f.severity }} VULNERABLE</span>
                    {% if is_disagree and plain_finding and not plain_finding.vulnerable %}
                      <span class="bypass-tag">⚡ BYPASS DETECTED</span>
                    {% endif %}
                  {% else %}
                    <span class="badge badge-pass">SAFE</span>
                  {% endif %}
                </td>
                <td><span class="badge badge-score-{{ f.likert_score }}">{{ f.likert_score }}/4</span></td>
                <td>{{ f.judge_type }}</td>
                <td>{{ (f.confidence * 100) | round(0) }}%</td>
                <td>{{ f.error or f.reasoning }}</td>
                <td style="text-align: center;">
                  <button type="button" class="btn-details" onclick="toggleDetails('{{ tray_id }}')">
                    🔍 Details
                  </button>
                </td>
              </tr>
              <tr id="{{ tray_id }}" class="details-tray" style="display: none;">
                <td colspan="7">
                  <div class="tray-content">
                    <div style="margin-bottom: 0.75rem;">
                      <div class="tray-title">📤 Sent Transformed Prompt ({{ f.converter_used or 'plain' }}):</div>
                      <div class="prompt-box">{{ f.sent_prompt or f.payload.prompt }}</div>
                    </div>
                    <div>
                      <div class="tray-title">📥 Target LLM Response Message:</div>
                      <div class="response-box">{{ f.response_text or "(No response / Error)" }}</div>
                    </div>
                    {% if f.error %}
                    <div style="margin-top: 0.75rem;">
                      <div class="reasoning" style="border-left-color: var(--high); background: rgba(249, 115, 22, 0.1); color: #fdba74;">
                        <strong>Transmission Error:</strong> {{ f.error }}
                      </div>
                    </div>
                    {% elif f.reasoning %}
                    <div style="margin-top: 0.75rem;">
                      <div class="reasoning" style="{% if not f.vulnerable %}border-left-color: #22c55e; background: rgba(34, 197, 94, 0.08); color: #86efac;{% endif %}">
                        <strong>Judge Reasoning:</strong> {{ f.reasoning }}
                      </div>
                    </div>
                    {% endif %}
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endfor %}
      {% else %}
        {% for finding in owasp_findings %}
        {% set item_tray_id = 'tray-single-' ~ finding.payload.id ~ '-' ~ loop.index %}
        <div class="finding-item">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <div>
              <code>[{{ finding.payload.id }}]</code> <strong>{{ finding.payload.category }}</strong>
              <span style="margin-left: 0.5rem; color: var(--text-muted); font-size: 0.85rem;">Judge: {{ finding.judge_type }} ({{ (finding.confidence * 100) | round(0) }}%)</span>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              {% if finding.error %}
                <span class="badge badge-high">ERROR</span>
              {% else %}
                <span class="badge badge-score-{{ finding.likert_score }}">Score {{ finding.likert_score }}/4</span>
                {% if finding.vulnerable %}
                  <span class="badge badge-{{ finding.severity.lower() }}">{{ finding.severity }} VULNERABLE</span>
                {% else %}
                  <span class="badge badge-pass">PASSED</span>
                {% endif %}
              {% endif %}
              <button type="button" class="btn-details" onclick="toggleDetails('{{ item_tray_id }}')">
                🔍 Details
              </button>
            </div>
          </div>

          <div style="margin-top: 0.75rem;">
            <strong style="font-size: 0.85rem; color: var(--text-muted);">Attack Prompt:</strong>
            <div class="prompt-box">{{ finding.sent_prompt or finding.payload.prompt }}</div>
          </div>

          <div id="{{ item_tray_id }}" style="display: block; margin-top: 0.75rem;">
            <strong style="font-size: 0.85rem; color: var(--text-muted);">Target Model Response:</strong>
            <div class="response-box">{{ finding.response_text or "(No response / Error)" }}</div>

            {% if finding.error %}
            <div class="reasoning" style="border-left-color: var(--high); background: rgba(249, 115, 22, 0.1); color: #fdba74;">
              <strong>Transmission Error:</strong> {{ finding.error }}
            </div>
            {% elif finding.reasoning %}
            <div class="reasoning" style="{% if not finding.vulnerable %}border-left-color: #22c55e; background: rgba(34, 197, 94, 0.08); color: #86efac;{% endif %}">
              <strong>Judge Reasoning:</strong> {{ finding.reasoning }}
            </div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
    {% endfor %}

    {% endif %}

    <!-- Multi-Turn Findings Section -->
    {% if multiturn_findings %}
    <div class="section-title">🔄 Multi-Turn Adversarial Red-Teaming Attacks</div>
    {% for mt in multiturn_findings %}
    <div class="category-group">
      <div class="category-header">
        <div class="category-header-left">
          <span class="owasp-code">{{ mt.owasp_id }}</span>
          <h3 style="margin: 0; font-size: 1.15rem; color: #ffffff;"><code>[{{ mt.payload_id }}]</code> {{ mt.category }}</h3>
        </div>
        <div>
          {% if mt.vulnerable %}
            <span class="badge badge-critical" style="font-size: 0.85rem; padding: 0.35rem 0.8rem;">🚨 BREACHED AT TURN {{ mt.succeeded_at_turn }} ({{ mt.severity }})</span>
          {% else %}
            <span class="badge badge-pass" style="font-size: 0.85rem; padding: 0.35rem 0.8rem;">🛡️ PASSED / RESISTED ({{ mt.full_transcript | length // 2 }} Turns)</span>
          {% endif %}
        </div>
      </div>
      <div style="padding: 1.25rem 1.5rem;">
        
        <!-- Attack Strategy & Objectives -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; margin-bottom: 1.25rem;">
          <div style="background: #0f172a; padding: 0.85rem 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <div style="font-size: 0.8rem; font-weight: 700; color: #38bdf8; text-transform: uppercase;">🎯 Adversarial Escalation Strategy</div>
            <div style="font-size: 0.9rem; color: #e2e8f0; margin-top: 0.25rem;">{{ mt.attack_strategy or 'Multi-turn conversational pressure & role escalation' }}</div>
          </div>
          <div style="background: #0f172a; padding: 0.85rem 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <div style="font-size: 0.8rem; font-weight: 700; color: #eab308; text-transform: uppercase;">🔍 Target Vulnerability Objective</div>
            <div style="font-size: 0.9rem; color: #e2e8f0; margin-top: 0.25rem;">{{ mt.stop_condition_hint or 'Coerce model into disclosing restricted data or bypassing constraints' }}</div>
          </div>
        </div>

        <!-- Vulnerability & Attack Factor Breakdown -->
        {% if mt.vulnerable %}
        <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid var(--critical); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
          <div style="font-weight: 800; color: #fca5a5; font-size: 0.95rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            ⚠️ Breach Impact & Compromised Vectors
          </div>
          
          {% if mt.breached_vulnerabilities %}
          <div style="margin-bottom: 0.6rem;">
            <strong style="font-size: 0.82rem; color: #fdba74;">Exposed Vulnerabilities:</strong>
            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.3rem;">
              {% for vuln in mt.breached_vulnerabilities %}
                <span class="badge badge-critical">{{ vuln }}</span>
              {% endfor %}
            </div>
          </div>
          {% endif %}

          {% if mt.breach_factors %}
          <div>
            <strong style="font-size: 0.82rem; color: #93c5fd;">Successful Attack Factors:</strong>
            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.3rem;">
              {% for factor in mt.breach_factors %}
                <span class="badge badge-low">{{ factor }}</span>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
        {% endif %}

        {% if mt.reasoning %}
        <div class="reasoning" style="margin-bottom: 1.25rem; {% if not mt.vulnerable %}border-left-color: var(--pass); background: rgba(34, 197, 94, 0.08); color: #86efac;{% endif %}">
          <strong>Judge Evaluation & Trajectory Analysis:</strong> {{ mt.reasoning }}
        </div>
        {% endif %}

        <details open>
          <summary style="cursor: pointer; font-weight: 700; color: #38bdf8; font-size: 0.95rem;">
            💬 View Turn-by-Turn Dialogue Trajectory ({{ mt.full_transcript | length }} messages)
          </summary>
          <div style="margin-top: 1rem;">
            {% for turn in mt.full_transcript %}
            {% set is_breach_turn = mt.succeeded_at_turn and turn.turn_number == mt.succeeded_at_turn and turn.role == 'target' %}
            <div style="padding: 0.85rem 1rem; border-radius: 6px; margin-bottom: 0.75rem; background: {% if turn.role == 'target' %}{% if is_breach_turn %}rgba(239, 68, 68, 0.15){% else %}#18243b{% endif %}{% else %}#0d1424{% endif %}; border: 1px solid {% if is_breach_turn %}var(--critical){% else %}var(--border-color){% endif %};">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-weight: 800; font-size: 0.85rem; color: {% if turn.role == 'target' %}#f472b6{% else %}#38bdf8{% endif %};">
                  Turn {{ turn.turn_number }} — {{ turn.role.upper() }}
                </div>
                {% if is_breach_turn %}
                  <span class="badge badge-critical">🚨 CRITICAL DEFENSE BREACH OCCURRED HERE</span>
                {% endif %}
              </div>
              <div class="prompt-box" style="margin-top: 0.5rem; {% if is_breach_turn %}border-color: #ef4444; color: #fca5a5;{% endif %}">{{ turn.content }}</div>
            </div>
            {% endfor %}
          </div>
        </details>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    <!-- Judge Evaluation Report Section -->
    {% if eval_report_data %}
    <div class="section-title">⚖️ Judge Accuracy & Benchmark Evaluation</div>
    <div class="meta-grid">
      <div class="card">
        <div class="title">Total Evaluated</div>
        <div class="value">{{ eval_report_data.summary.total_samples }}</div>
      </div>
      <div class="card">
        <div class="title">Accuracy</div>
        <div class="value" style="color: var(--pass);">{{ (eval_report_data.summary.accuracy * 100) | round(1) }}%</div>
      </div>
      <div class="card">
        <div class="title">Precision / Recall</div>
        <div class="value" style="font-size: 1.25rem;">P: {{ (eval_report_data.summary.precision * 100) | round(1) }}% | R: {{ (eval_report_data.summary.recall * 100) | round(1) }}%</div>
      </div>
      <div class="card">
        <div class="title">F1 Score</div>
        <div class="value" style="color: #38bdf8;">{{ eval_report_data.summary.f1_score }}</div>
      </div>
    </div>
    {% endif %}

    <div class="footer">
      Generated by OWASP Top 10 for LLM Applications Security Scanner — Version 2.1
    </div>
  </div>
</body>
</html>

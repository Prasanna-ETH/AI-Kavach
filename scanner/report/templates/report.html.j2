<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LLM Security Scan Report</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
      --critical: #ef4444;
      --high: #f97316;
      --medium: #eab308;
      --low: #3b82f6;
      --pass: #22c55e;
      --font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-family);
      margin: 0;
      padding: 2rem;
      line-height: 1.5;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
    }
    .header {
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    .header h1 {
      margin: 0 0 0.5rem 0;
      font-size: 2.25rem;
      color: #38bdf8;
    }
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.25rem;
    }
    .card .title {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .card .value {
      font-size: 1.75rem;
      font-weight: 700;
    }
    .badge {
      display: inline-block;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
    }
    .badge-critical { background: var(--critical); color: #fff; }
    .badge-high { background: var(--high); color: #fff; }
    .badge-medium { background: var(--medium); color: #000; }
    .badge-low { background: var(--low); color: #fff; }
    .badge-pass { background: var(--pass); color: #fff; }
    .badge-score-0 { background: #15803d; color: #fff; }
    .badge-score-1 { background: #0284c7; color: #fff; }
    .badge-score-2 { background: #ca8a04; color: #000; }
    .badge-score-3 { background: #ea580c; color: #fff; }
    .badge-score-4 { background: #b91c1c; color: #fff; }

    .grade-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      font-weight: 800;
      font-size: 1.1rem;
      margin-left: 0.5rem;
    }
    .grade-A { background: #16a34a; color: #fff; }
    .grade-B { background: #22c55e; color: #000; }
    .grade-C { background: #eab308; color: #000; }
    .grade-D { background: #f97316; color: #fff; }
    .grade-F { background: #dc2626; color: #fff; }
    
    .owasp-tag {
      background: #334155;
      color: #38bdf8;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.8rem;
      font-family: monospace;
      margin-right: 0.5rem;
    }

    .findings-section {
      margin-top: 2rem;
    }
    .finding-item {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .finding-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.75rem;
    }
    .finding-title {
      font-size: 1.1rem;
      font-weight: 600;
    }
    .prompt-box, .response-box {
      background: #090d16;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 1rem;
      font-family: monospace;
      font-size: 0.9rem;
      white-space: pre-wrap;
      word-break: break-word;
      margin-top: 0.5rem;
      color: #e2e8f0;
    }
    .reasoning {
      background: rgba(248, 113, 113, 0.1);
      border-left: 4px solid var(--critical);
      padding: 0.75rem 1rem;
      margin-top: 1rem;
      border-radius: 0 4px 4px 0;
      color: #fca5a5;
    }
    .turn-box {
      background: #0d1527;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 1rem;
      margin-top: 0.75rem;
    }
    .turn-box.succeeded-turn {
      border: 2px solid var(--critical);
      background: rgba(239, 68, 68, 0.08);
    }
    .turn-role {
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
    }
    .turn-attacker { color: #38bdf8; }
    .turn-target { color: #f472b6; }

    .footer {
      text-align: center;
      color: var(--text-muted);
      margin-top: 3rem;
      font-size: 0.875rem;
      border-top: 1px solid var(--border-color);
      padding-top: 1.5rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🛡️ LLM Security Scan Report</h1>
      <p style="color: var(--text-muted); margin: 0;">Target: <code>{{ result.target_url if result else target_url }}</code></p>
    </div>

    {% if result %}
    <div class="meta-grid">
      <div class="card">
        <div class="title">Security Posture Score</div>
        <div class="value">
          {{ result.posture_score | round(1) }} <span class="grade-badge grade-{{ result.grade }}">{{ result.grade }}</span>
        </div>
      </div>
      <div class="card">
        <div class="title">Total Payloads</div>
        <div class="value">{{ result.total_payloads }}</div>
      </div>
      <div class="card">
        <div class="title">Vulnerabilities Flagged</div>
        <div class="value" style="color: {% if result.vulnerable_count > 0 %}var(--critical){% else %}var(--pass){% endif %};">
          {{ result.vulnerable_count }}
        </div>
      </div>
      <div class="card">
        <div class="title">Duration</div>
        <div class="value">{{ result.duration_seconds | round(2) }}s</div>
      </div>
    </div>

    {% if result.likert_distribution %}
    <div class="card" style="margin-bottom: 2rem;">
      <div class="title">Graduated Likert Severity Distribution (0 to 4 Scale)</div>
      <div style="display: flex; gap: 0.75rem; margin-top: 0.75rem; flex-wrap: wrap;">
        <span class="badge badge-score-0">Score 0 (Safe): {{ result.likert_distribution.get(0, 0) }}</span>
        <span class="badge badge-score-1">Score 1 (Benign): {{ result.likert_distribution.get(1, 0) }}</span>
        <span class="badge badge-score-2">Score 2 (Boundary Slip): {{ result.likert_distribution.get(2, 0) }}</span>
        <span class="badge badge-score-3">Score 3 (Substantial): {{ result.likert_distribution.get(3, 0) }}</span>
        <span class="badge badge-score-4">Score 4 (Critical): {{ result.likert_distribution.get(4, 0) }}</span>
      </div>
    </div>
    {% endif %}

    <div class="findings-section">
      <h2>Single-Turn Findings Details</h2>
      {% for finding in result.findings %}
      <div class="finding-item">
        <div class="finding-header">
          <div class="finding-title">
            <span class="owasp-tag">{{ finding.payload.owasp_id }}</span>
            <code>[{{ finding.payload.id }}]</code> {{ finding.payload.category }}
          </div>
          <div>
            <span class="badge badge-score-{{ finding.likert_score }}">Likert Score {{ finding.likert_score }}/4</span>
            {% if finding.vulnerable %}
              <span class="badge badge-{{ finding.severity.lower() }}">{{ finding.severity }} VULNERABLE</span>
            {% else %}
              <span class="badge badge-pass">PASSED</span>
            {% endif %}
          </div>
        </div>

        <div>
          <strong>Judge Type:</strong> <code>{{ finding.judge_type }}</code> |
          <strong>Confidence:</strong> {{ (finding.confidence * 100) | round(0) }}%
        </div>

        <div style="margin-top: 1rem;">
          <strong>Attack Prompt:</strong>
          <div class="prompt-box">{{ finding.payload.prompt }}</div>
        </div>

        <div style="margin-top: 1rem;">
          <strong>Target Model Response:</strong>
          <div class="response-box">{{ finding.response_text or "(No response / Error)" }}</div>
        </div>

        {% if finding.reasoning %}
        <div class="reasoning" style="{% if not finding.vulnerable %}border-left-color: #22c55e; background: rgba(34, 197, 94, 0.08); color: #86efac;{% endif %}">
          <strong>Judge Evaluation:</strong> {{ finding.reasoning }}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if multiturn_findings %}
    <div class="findings-section">
      <h2>Multi-Turn Adversarial Attack Findings</h2>
      {% for mt in multiturn_findings %}
      <div class="finding-item">
        <div class="finding-header">
          <div class="finding-title">
            <span class="owasp-tag">{{ mt.owasp_id }}</span>
            <code>[{{ mt.payload_id }}]</code> {{ mt.category }}
          </div>
          <div>
            {% if mt.vulnerable %}
              <span class="badge badge-{{ mt.severity.lower() }}">{{ mt.severity }} VULNERABLE (Turn {{ mt.succeeded_at_turn }})</span>
            {% else %}
              <span class="badge badge-pass">PASSED</span>
            {% endif %}
          </div>
        </div>

        <div>
          <strong>Total Turns Executed:</strong> {{ mt.full_transcript | length // 2 }} |
          <strong>Succeeded at Turn:</strong> {{ mt.succeeded_at_turn or 'None' }}
        </div>

        {% if mt.reasoning %}
        <div class="reasoning">
          <strong>Multi-Turn Judge Evaluation:</strong> {{ mt.reasoning }}
        </div>
        {% endif %}

        <details style="margin-top: 1.5rem;" open>
          <summary style="cursor: pointer; font-weight: 600; color: #38bdf8;">
            View Full Turn-by-Turn Dialogue Transcript ({{ mt.full_transcript | length }} messages)
          </summary>
          <div style="margin-top: 1rem;">
            {% for turn in mt.full_transcript %}
            <div class="turn-box {% if mt.succeeded_at_turn and turn.turn_number == mt.succeeded_at_turn and turn.role == 'target' %}succeeded-turn{% endif %}">
              <div class="turn-role turn-{{ turn.role }}">
                Turn {{ turn.turn_number }} - {{ turn.role.upper() }}
                {% if mt.succeeded_at_turn and turn.turn_number == mt.succeeded_at_turn and turn.role == 'target' %}
                  <span style="color: var(--critical); margin-left: 0.5rem;">⚠️ EARLIEST VULNERABLE RESPONSE</span>
                {% endif %}
              </div>
              <div class="prompt-box" style="margin-top: 0.4rem;">{{ turn.content }}</div>
            </div>
            {% endfor %}
          </div>
        </details>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="footer">
      Generated by OWASP Top 10 for LLM Applications Security Scanner
    </div>
  </div>
</body>
</html>
